# =============================================================================
# CloudDocs Environment Variables Example
# =============================================================================

# Server
PORT=8000
HOST=0.0.0.0
APP_ENV=development
DEBUG=true

# Mock Mode Toggle (set true to test without AWS credentials or local MySQL)
MOCK_MODE=true

# AWS Configuration (when running in AWS or with AWS IAM credentials)
AWS_REGION=us-east-1
DOCUMENT_BUCKET_NAME=clouddocs-prod-documents-xxxxxx
SECRET_ARN_DB=arn:aws:secretsmanager:us-east-1:123456789012:secret:clouddocs/prod/rds-mysql-credentials-xxxxxx

# Direct DB Configuration (used if Secrets Manager is bypassed)
DB_HOST=localhost
DB_PORT=3306
DB_USER=clouddocs_admin
DB_PASSWORD=your_secure_password
DB_NAME=clouddocs_db

# Presigned URL Expiration in seconds
PRESIGNED_URL_EXPIRATION=900
